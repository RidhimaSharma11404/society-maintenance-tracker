# ===============================================
# Greenwood Heights Ops Portal - Environment Configuration
# ===============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Leave blank to use embedded zero-config in-memory MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/society_maintenance_db

# Security & Authentication
JWT_SECRET=greenwood_heights_super_secret_jwt_key_2026!
JWT_EXPIRES_IN=7d

# File Upload Directory
UPLOAD_DIR=public/uploads

# Notification / SMTP Service (Free tier or test service: Ethereal / SendGrid / Resend)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=demo.user@ethereal.email
SMTP_PASS=demopassword123
NOTIFICATION_FROM=no-reply@greenwood.com
